{
  "name": "smart-recovery-bot",
  "main": "worker.js",
  "compatibility_date": "2024-01-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "XAU_SETUP_LOCK",
        "class_name": "XAUSetupLock"
      }
    ]
  },
  "exports": {
    "XAUSetupLock": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
